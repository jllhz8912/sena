# ============================================================
# Configuración de VetCompras (copie este archivo como .env)
# ============================================================

# Puerto del programa (se abre en http://localhost:3000)
PUERTO=3000

# 127.0.0.1 = solo este PC.
# 0.0.0.0   = permite abrir VetCompras desde otros equipos de la red local
#             de la veterinaria con http://IP-DE-ESTE-PC:3000
HOST=127.0.0.1

# Carpeta donde se guarda la base de datos y los respaldos.
# Por defecto: C:\Users\<usuario>\VetCompras\datos
# VETCOMPRAS_DATOS=D:\VetCompras\datos

# OPCIONAL: lectura automática de facturas en PDF con Gemini (requiere internet).
# Los XML de la DIAN se procesan siempre sin internet y sin esta clave.
# Obtenga la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
