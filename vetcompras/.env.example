# ============================================================
# Configuración de Sistema de Control 2.0 (copie este archivo como .env)
# ============================================================

# Puerto del programa (se abre en http://localhost:3000)
PUERTO=3000

# 127.0.0.1 = solo este PC.
# 0.0.0.0   = permite abrir el programa desde otros equipos de la red local
#             de la empresa con http://IP-DE-ESTE-PC:3000
HOST=127.0.0.1

# Etapa del sistema: 'prueba' muestra el aviso de versión de prueba y el botón
# "Observación" para que los probadores reporten errores o sugerencias.
# ETAPA=prueba

# Carpeta donde se guarda la base de datos y los respaldos.
# Por defecto: C:\Users\<usuario>\SistemaControl\datos
# SISTEMA_CONTROL_DATOS=D:\SistemaControl\datos

# OPCIONAL: lectura automática de facturas en PDF con Gemini (requiere internet).
# Los XML de la DIAN se procesan siempre sin internet y sin esta clave.
# Obtenga la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Abrir el programa en su propia ventana (1, recomendado) o como pestaña del navegador (0)
APP_VENTANA=1
