{
  "entities": {
    "Documento": {
      "title": "Documento",
      "description": "Factura de compra o documento soporte de la veterinaria",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "folio": { "type": "string" },
        "fechaEmision": { "type": "string" },
        "total": { "type": "number" }
      },
      "required": ["id", "folio", "fechaEmision", "total"]
    },
    "Venta": {
      "title": "Venta",
      "description": "Registro de venta veterinaria (Pet shop, clínica, baños, purinas, medicamentos)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fecha": { "type": "string" },
        "categoria": { "type": "string" },
        "total": { "type": "number" },
        "medioPago": { "type": "string" }
      },
      "required": ["id", "fecha", "categoria", "total", "medioPago"]
    },
    "Proveedor": {
      "title": "Proveedor",
      "description": "Proveedor de la clínica veterinaria",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nit": { "type": "string" },
        "razonSocial": { "type": "string" }
      },
      "required": ["id", "nit", "razonSocial"]
    },
    "Categoria": {
      "title": "Categoria",
      "description": "Categoría de compras o gastos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" }
      },
      "required": ["id", "nombre"]
    },
    "CentroCosto": {
      "title": "CentroCosto",
      "description": "Centro de costo o área clínica",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" }
      },
      "required": ["id", "nombre"]
    },
    "EmpresaConfig": {
      "title": "EmpresaConfig",
      "description": "Datos de la clínica veterinaria adquirente",
      "type": "object",
      "properties": {
        "nit": { "type": "string" },
        "razonSocial": { "type": "string" }
      },
      "required": ["nit", "razonSocial"]
    }
  },
  "firestore": {
    "/documentos/{documentoId}": {
      "schema": "Documento",
      "description": "Facturas y documentos sincronizados en la nube"
    },
    "/ventas/{ventaId}": {
      "schema": "Venta",
      "description": "Ventas de la veterinaria sincronizadas en tiempo real en la nube"
    },
    "/proveedores/{proveedorId}": {
      "schema": "Proveedor",
      "description": "Proveedores sincronizados"
    },
    "/categorias/{categoriaId}": {
      "schema": "Categoria",
      "description": "Catálogo de categorías"
    },
    "/centrosCosto/{centroCostoId}": {
      "schema": "CentroCosto",
      "description": "Catálogo de centros de costo"
    },
    "/configuracion/{configId}": {
      "schema": "EmpresaConfig",
      "description": "Configuración de la veterinaria"
    }
  }
}
