{
  "name": "vetcompras",
  "private": true,
  "version": "2.4.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts --dev",
    "build": "vite build",
    "start": "tsx server.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "recuperar-acceso": "tsx scripts/recuperarAcceso.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build:portable": "npm run build && node scripts/empaquetarPortable.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tesseract.js-data/spa": "^1.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.3",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "description": "VetCompras: control de compras, gastos, ventas e informes tributarios para veterinarias en Colombia (instalación local).",
  "engines": {
    "node": ">=22.13.0"
  }
}
